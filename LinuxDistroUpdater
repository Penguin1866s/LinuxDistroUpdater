#==============================================================================
# SNAPSHOT FUNCTION (call an external script)
#==============================================================================

create_snapshot() {
    echo_log_msg "Verifying Timeshift availability..."

    # Verify is the script snapshoft_timeshift file exist
    if [ ! -f "$SNAPSHOT_TIMESHIFT_SCRIPT" ]; then
        echo_log_msg "ERROR: Timeshift script not found: $TIMESHIFT_SCRIPT"

        end_loop_first=1
        #This loop is for repeat the question in the case that the user don't type 'Y' or 'y' or 'S' or 's' or 'N' or 'n'
        while [ "$end_loop_first" -eq 1 ]
        do
            read -p "Continue without snapshot? (y/n): " -n 1 -r #The -n is for typing only one character and auto enter, the -p is for store the value of the read in "$REPLY", and -r is for not interpret the scape caracter
            echo -e "\n${REPLY}"
            if [[ "$REPLY" =~ ^[YySs]$ ]]; then #the "=~" is for compare the regular expresion
                echo_log_msg "Continuing without snapshot.."
                end_loop_first=0
            elif [[ "$REPLY" =~ ^[Nn]$ ]]; then
                echo_log_msg "Operation cancelled by user."
                end_loop_first=0
            else
                echo -e "ERROR: Incorrect value\n"
            fi
        done
    fi

    # Check if the script of snapshot timeshit is executable or not
    if [ ! -x "$SNAPSHOT_TIMESHIFT_SCRIPT" ]; then
        echo_log_msg "Making Timeshift script executable.."
        chmod +x "$SNAPSHOT_TIMESHIFT_SCRIPT"
    fi

    #Execute the external script for make timeshift snapshot
    echo_log_msg "Executing external Timeshift script.."
    bash "$SNAPSHOT_TIMESHIFT_SCRIPT"

    snapshot_exit_code=$?

    if [ "$snapshot_exit_code" -eq 0 ]; then
        echo_log_msg "Restore point created successfully. :)"
        return 0 #To end the execution of this function, 0 indicate 0 errors
    else
        echo_log_msg "WARNING: Problems creating snapshot (exit code: $snapshot_exit_code)"

        end_loop_second=1
        #This loop is for repeat the question in the case that the user don't type 'Y' or 'y' or 'S' or 's' or 'N' or 'n'
        while [ "$end_loop_second" -eq 1 ]
        do
            read -p "Continue without snapshot? (y/n): " -n 1 -r #The -n is for typing only one character and auto enter, the -p is for store the value of the read in "$REPLY", and -r is for not interpret the scape caracter
            echo -e "\n${REPLY}"
            if [[ "$REPLY" =~ ^[YySs]$ ]]; then #the "=~" is for compare the regular expresion
                echo_log_msg "Continuing without snapshot.."
                end_loop_second=0
            elif [[ "$REPLY" =~ ^[Nn]$ ]]; then
                echo_log_msg "Operation cancelled by user."
                exit 1 #exit the script
            else
                echo -e "ERROR: Incorrect value\n"
            fi
        done
    fi
    echo_log_msg "Create snapshot: done✨"
}


#==============================================================================
# ARGUMENT PROCCESSING
#==============================================================================
#using "getopts"(an internal tool to process multiply arguments)
parse_arguments() {
    if [ $# -eq 0 ]; then #check if it has some argument
        show_help
        exit 0
    fi

    arguments_list=("$@") #transform the arguments into a iterable list
    i=0 #index of the next while loop

    # This is maked whit a while insted with a for loop, for the package-manager option, to be possible to obtain a parameter for that option
    while [ "$i" -lt "${#arguments_list[@]}" ] #while i is lower than the length of the quantity of arguments of that list
    do
        argument="${arguments_list[$i]}"
        if [ "${argument:0:2}" == "--" ]; then #cut the two firts characters of the argument to check if the two firts characters of the argument are -- or in the next elif if is one
            clean_argument="${argument:2}" #cut the two firts characters ("--" in this case)
            case "$clean_argument" in
                help)
                    show_help
                    exit 0
                    ;;
                version)
                    echo "Linux Distro Updater: v${VERSION}"
                    exit 0
                    ;;
                list-managers)
                    show_supported_package_managers
                    exit 0
                    ;;
                install)
                    INSTALL=true
                    ;;
                snapshot)
                    DO_SNAPSHOT=true
                    ;;
                basic)
                    DO_BASIC_UPDATE=true
                    ;;
                full)
                    DO_FULL_UPDATE=true
                    ;;
                cleanup)
                    DO_CLEANUP=true
                    ;;
                all)
                    DO_SNAPSHOT=true
                    DO_FULL_UPDATE=true
                    DO_CLEANUP=true
                    ;;
                package-manager)
                    (( i++ )) #Sum one to the index variable to skip the expected name_manager_package
                    if [ "$i" -lt "${#arguments_list[@]}" ]; then #If the index value is lower than the total quality of arguments
                        FORCE_PKG_MANAGER="${arguments_list[$i]}"
                    else
                        pre_formated_list_package_manager_supported="${list_package_manager_supported[@]}"
                        formated_list_package_manager_supported="${pre_formated_list_package_manager_supported// /, }" #To format the list of list_package_manager_supported subtituting the spaces (" ") with comas and an space (", ")
                        echo_log_msg "ERROR: --package-manager requires an argument (${formated_list_package_manager_supported})"
                        exit 1
                    fi
                    ;;
                *)
                    echo_log_msg "ERROR: Unknown option: --$clean_argument"
                    echo_log_msg "Use --help to see the available options"
                    exit 1
                ;;
            esac

        elif [ "${argument:0:1}" == "-" ]; then #cut the firts characters of the argument to check if the first characters of the argument is '-' or not
            clean_argument="${argument:1}" #cut the firts character ('-' in this case)
            length_simple_argument="${#clean_argument}"

            #The next for is for the cases of the simple arguments compunds of more than one (example: -bs, basic update & snapshot)
            for (( k=0; k<length_simple_argument; k++ )) # for iterate over the letters of the simple argument
            do
                actual_letter="${clean_argument:k:1}" #since postion k, obtain 1 caracter
                case "$actual_letter" in
                    h)
                        show_help
                        exit 0
                        ;;
                    v)
                        echo "Linux Distro Updater: v${VERSION}"
                        exit 0
                        ;;
                    l)
                        show_supported_package_managers
                        exit 0
                        ;;
                    i)
                        INSTALL=true
                        ;;
                    s)
                        DO_SNAPSHOT=true
                        ;;
                    b)
                        DO_BASIC_UPDATE=true
                        ;;
                    f)
                        DO_FULL_UPDATE=true
                        ;;
                    c)
                        DO_CLEANUP=true
                        ;;
                    a)
                        DO_SNAPSHOT=true
                        DO_FULL_UPDATE=true
                        DO_CLEANUP=true
                        ;;
                    p)
                        (( i++ )) #Sum one to the index variable to skip the expected name_manager_package
                        if [ "$i" -lt "${#arguments_list[@]}" ]; then #If the index value is lower than the total quality of arguments
                            FORCE_PKG_MANAGER="${arguments_list[$i]}"
                        else
                            pre_formated_list_package_manager_supported="${list_package_manager_supported[@]}"
                            formated_list_package_manager_supported="${pre_formated_list_package_manager_supported// /, }" #To format the list of list_package_manager_supported subtituting the spaces (" ") with comas and an space (", ")
                            echo_log_msg "ERROR: --package-manager requires an argument (${formated_list_package_manager_supported})"
                            exit 1
                        fi
                        ;;
                    *)
                        echo_log_msg "ERROR: Unknown option: -$actual_letter"
                        echo_log_msg "Use -h or --help to see the available options"
                        exit 1
                        ;;
                esac
            done
        else
            #If don't start with '-' or "--" is an invalid argument
            echo_log_msg "ERROR: Invalid argument: $argument"
            show_help
            exit 1
        fi

        (( i++ )) #Goes to next argument
    done

    # Possible future implementation, add an --only-snapshot, in the case that only whant to snapshot, for now only puting "-s" or "--snapshot"
}

main() {
    # Check if it parse arguments or not
    parse_arguments "$@"
    
    # Verify that is executing by a user with root/ sudo privileges
    check_root

    # Rotate log if is necesari, check abd rotateit if is necesari the log archive
    rotate_log

    # Welcome message
    echo_log_msg "======================================================="
    echo_log_msg "   Welcom to the \033[1mLinux Distro Updater\033[0m v${VERSION}, enjoy!" # The "\033[1m" and "\033[0m" are escape characters to activate and deactivate the bold text
    echo_log_msg "======================================================="

    # Detect the package manager
    PKG_MANAGER=$(detect_main_package_manager)

    if [ "$INSTALL" = true ]; then
        install_linuxDistroUpdater
    fi
    # Execute snapshot if it requested
    if [ "$DO_SNAPSHOT" = true ]; then
        create_snapshot
    fi

    if [ "$DO_BASIC_UPDATE" = true ]; then
        basic_update
    fi

    if [ "$DO_FULL_UPDATE" = true ]; then
        full_update
    fi

    if [ "$DO_CLEANUP" = true ]; then
        cleanup_system
    fi

    echo_log_msg "======================================================="
    echo_log_msg "✨ Process completed successfully ✨"
    echo_log_msg "======================================================="
}
main "$@"

